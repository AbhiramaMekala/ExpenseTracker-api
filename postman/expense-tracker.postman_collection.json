{
  "info": {
    "name": "Expense Tracker API",
    "description": "All 6 endpoints with test scripts. Run the folder top to bottom (Collection Runner) against a running server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "expenseId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Add expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Groceries\",\n  \"amount\": 42.5,\n  \"category\": \"food\",\n  \"spent_on\": \"2026-09-14\",\n  \"note\": \"Weekly shop\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"expenseId\", body.id);",
              "pm.test(\"Amount saved\", () => pm.expect(body.amount).to.eql(42.5));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Add expense - invalid amount (expect 422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Bad\",\n  \"amount\": -1,\n  \"category\": \"food\",\n  \"spent_on\": \"2026-09-14\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. List expenses",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Returns an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. List expenses - food in Sept 2026",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/expenses?category=food&month=2026-09",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses"
          ],
          "query": [
            {
              "key": "category",
              "value": "food"
            },
            {
              "key": "month",
              "value": "2026-09"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Get expense by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "{{expenseId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correct id\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"expenseId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Update expense",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "{{expenseId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Groceries + snacks\",\n  \"amount\": 55.2,\n  \"category\": \"food\",\n  \"spent_on\": \"2026-09-14\",\n  \"note\": \"Updated\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Title updated\", () => pm.expect(pm.response.json().title).to.eql(\"Groceries + snacks\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Monthly summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/expenses/summary?by=month",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "summary"
          ],
          "query": [
            {
              "key": "by",
              "value": "month"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has rows\", () => pm.expect(pm.response.json().rows).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Category summary for a month",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/expenses/summary?by=category&month=2026-09",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "summary"
          ],
          "query": [
            {
              "key": "by",
              "value": "category"
            },
            {
              "key": "month",
              "value": "2026-09"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Delete expense",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "{{expenseId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Get deleted expense (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/expenses/{{expenseId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "expenses",
            "{{expenseId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}